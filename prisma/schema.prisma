generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}


model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
}

model WorkType {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  entries JournalEntry[]
}

model JournalEntry {
  id           Int      @id @default(autoincrement())
  date         DateTime
  workType     WorkType @relation(fields: [workTypeId], references: [id])
  workTypeId   Int
  volume       Float
  unit         String
  performer    String
  notes        String?
  createdAt    DateTime @default(now())
}
